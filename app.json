{
  "expo": {
    "name": "Rastro",
    "slug": "cacambas-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/app-icon.png",
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.rastroapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-monochrome-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "br.com.rastroapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/web-favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este app precisa de acesso à localização para registrar entregas e retiradas de caçambas."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#ffffff",
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 150,
            "resizeMode": "contain"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "rastro",
    "extra": {
      "eas": {
        "projectId": "e564923e-2ab3-4e82-8b63-5d41a7309bf3"
      }
    }
  }
}
